# Voice Provider (Options: 'twilio' or 'telnyx')
VOICE_PROVIDER=twilio

# Twilio Credentials
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_phone_number_here

# Telnyx Credentials
TELNYX_API_KEY=your_api_key_here  
TELNYX_PUBLIC_KEY=your_public_key_here
TELNYX_APP_ID=your_application_id_here
TELNYX_PHONE_NUMBER=your_phone_number_here

# Ultravox API
ULTRAVOX_API_KEY=your_api_key_here
ULTRAVOX_AGENT_ID=your_agent_id_here
ULTRAVOX_WEBSOCKET_URL=wss://api.ultravox.ai/v1/ws
ULTRAVOX_API_URL=https://api.ultravox.ai/api/calls
ULTRAVOX_CORPUS_ID=your_corpus_id_here

# UI Configuration
UI_LOGO_URL=https://your-logo-url.com/logo.png
UI_APP_NAME=YourAppName

# AI Assistant Configuration
AI_ASSISTANT_NAME=Assistant
AI_ASSISTANT_VOICE_ID=your_voice_id_here
AI_TEMPERATURE=0.3
INBOUND_FIRST_SPEAKER=FIRST_SPEAKER_AGENT
OUTBOUND_FIRST_SPEAKER=FIRST_SPEAKER_USER

# System Prompts
OUTBOUND_SYSTEM_PROMPT="You are a professional voice AI assistant named {AI_NAME}. Your role is to provide clear, helpful responses to user inquiries."
INBOUND_SYSTEM_PROMPT="You are a helpful voice AI assistant named {AI_NAME}. Your goal is to assist callers with their questions and requests."

# Agent preprompt (will be prepended to all system prompts)
AGENT_PREPROMPT="You are {AGENT_NAME}, an AI voice assistant."

# Server configuration
PORT=3000

# Calendar integration
DEFAULT_CALENDAR_PROVIDER=google
CALENDAR_OWNER=Your Name or Company

# Email handling for calendar appointments
EMAIL_PROMPT="When scheduling appointments, include the user's email '{USER_EMAIL}' if provided. If not provided, ask for their email address to include in the meeting invitation."

# Tools configuration (detailed settings in .env.tools)
ULTRAVOX_USE_TOOLS=false