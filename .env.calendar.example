# Calendar Integration Configuration

# Google Calendar API
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
GOOGLE_REDIRECT_URI=https://your-domain.com/oauth2callback

# Microsoft Calendar API
MS_CLIENT_ID=your_microsoft_client_id_here
MS_CLIENT_SECRET=your_microsoft_client_secret_here
MS_USER_EMAIL=your_email@example.com
MS_REFRESH_TOKEN=your_microsoft_refresh_token_here

# Default provider
DEFAULT_CALENDAR_PROVIDER=google  # Options: google, microsoft

# Calendar owner information
CALENDAR_OWNER=Your Name or Company

# Calendar functionality prompting
CALENDAR_PROMPT="You can check calendar availability and schedule appointments. 
When a user asks about scheduling a meeting or call:
1. Ask what the meeting is about
2. Ask them what day or time range they're interested in
3. Use the calendar tool to check availability
4. Offer available time slots
5. Once they select a time, use the calendar-schedule tool to create the appointment
6. Confirm the details and let them know the appointment has been scheduled"

# Email handling
EMAIL_PROMPT="When scheduling appointments, include the user's email '{USER_EMAIL}' if provided. If not provided, ask for their email address to include in the meeting invitation." 