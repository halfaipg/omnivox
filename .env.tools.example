# Tool System Configuration

# Enable/disable the tool system
ULTRAVOX_USE_TOOLS=true

# Enable/disable the built-in hangUp tool (defaults to true if not set)
ULTRAVOX_USE_HANGUP=true

# Time greeting configuration
# Enable/disable time-based greeting (gets time, timezone, and day of week from client's local session)
ULTRAVOX_USE_TIME_GREETING=true

# Custom time greeting message with placeholders
ULTRAVOX_TIME_GREETING_MESSAGE="Hello, it's {timeString}, {dayOfWeek} {timeOfDay}."

# Example Calendar Tool
ULTRAVOX_TOOL_1_NAME=calendar
ULTRAVOX_TOOL_1_DESCRIPTION=Check calendar availability for meetings. Provide date range to check.
ULTRAVOX_TOOL_1_URL=https://your-api.com/calendar/availability
ULTRAVOX_TOOL_1_METHOD=GET
ULTRAVOX_TOOL_1_PARAMS=[{"name":"startDate","location":"PARAMETER_LOCATION_QUERY","schema":{"type":"string"},"required":true},{"name":"days","location":"PARAMETER_LOCATION_QUERY","schema":{"type":"integer"},"required":false}]
ULTRAVOX_TOOL_1_RESPONSE_SCHEMA={"type":"object","properties":{"slots":{"type":"array"}}}

# Example Scheduling Tool
ULTRAVOX_TOOL_2_NAME=schedule
ULTRAVOX_TOOL_2_DESCRIPTION=Schedule a meeting. Requires date, time, and purpose.
ULTRAVOX_TOOL_2_URL=https://your-api.com/schedule
ULTRAVOX_TOOL_2_METHOD=POST
ULTRAVOX_TOOL_2_PARAMS=[{"name":"purpose","location":"PARAMETER_LOCATION_BODY","schema":{"type":"string"},"required":true},{"name":"dateTime","location":"PARAMETER_LOCATION_BODY","schema":{"type":"string"},"required":true},{"name":"attendees","location":"PARAMETER_LOCATION_BODY","schema":{"type":"array"},"required":false}]

# Example Weather Tool
ULTRAVOX_TOOL_3_NAME=weather
ULTRAVOX_TOOL_3_DESCRIPTION=Get current weather information for a location.
ULTRAVOX_TOOL_3_URL=https://your-weather-api.com/current
ULTRAVOX_TOOL_3_METHOD=GET
ULTRAVOX_TOOL_3_PARAMS=[{"name":"location","location":"PARAMETER_LOCATION_QUERY","schema":{"type":"string"},"required":true}]

# Tool usage guidelines
ULTRAVOX_TOOL_GUIDELINES="
- Use tools proactively when relevant to the conversation
- For scheduling: Check availability before scheduling appointments
- For weather: Ask for location if not specified
- Respond with information from tools in a natural, conversational way"

# List of enabled tools (comma-separated)
ULTRAVOX_CALL_TOOLS=calendar,schedule,weather 